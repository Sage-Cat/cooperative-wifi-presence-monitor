@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam componentStyle rectangle
skinparam packageStyle rectangle
top to bottom direction
rectangle "Observation producer" as Producer
node "Qualified host target\nLinux first; embedded later" as Host {
  folder "Read-only installation" {
    artifact "Monitor executable\ncore + concrete adapters" as Executable
  }
  folder "Operator-managed inputs" {
    artifact "Reviewed model\n+ feature bundle" as Bundle
    artifact "Startup-only configuration" as Config
  }
  component "Unprivileged monitor process\nrunner + coordinator + worker + timer" as Process #DCEAF6
  folder "Volatile runtime directory" {
    artifact "One atomic current-result JSON\n+ separate diagnostics / optional history" as Result
  }
  component "Local consuming application" as Consumer
}
Executable ..> Process : executes
Producer --> Process : explicitly configured local stream
Config --> Process : read-only
Bundle --> Process : read-only
Process -right-> Result : same-filesystem replacement
Result --> Consumer : schema + clock domain + expiry
Consumer --> Consumer : independent use-time validity

@enduml
