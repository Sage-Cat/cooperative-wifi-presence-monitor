@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam componentStyle rectangle
skinparam packageStyle rectangle
autonumber
actor Integrator
participant "Observation source" as Source
participant "Coordinator" as Core
participant "Bundle validator" as Validator
participant "Inference worker" as Worker
participant "Result publisher" as Publisher
Integrator -> Core : explicit bundle / profile reload
Core -> Core : advance generation; clear assembled\nand pending windows
Core -> Publisher : current unknown; reconfiguration
Core -> Validator : validate identity, features, class semantics,\nsubset and operating contract
Worker -->> Core : completion from previous generation
Core -> Core : discard old-generation completion
alt candidate bundle accepted
  Validator --> Core : verified immutable bundle
  Core -> Core : activate bundle; wait for new evidence
  Source -> Core : new compatible window
  Core ->> Worker : new-generation qualified job
  Worker -->> Core : new-generation candidate
  Core -> Core : check generation, applicability and age
  Core -> Publisher : accepted current decision only
else candidate bundle rejected
  Validator --> Core : rejection reasons
  Core -> Publisher : current unknown; bundle reasons
end

@enduml
