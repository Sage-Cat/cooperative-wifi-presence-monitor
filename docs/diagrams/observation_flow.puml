@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam backgroundColor white
skinparam ArrowColor #334155
skinparam componentStyle rectangle
skinparam packageStyle rectangle
autonumber
participant "NDJSON decoder" as Adapter
participant "Linux runner\nclock + worker handoff" as Host
participant "PresenceMonitor" as Core
participant "Pure domain rules" as Rules
participant "Worker +\ninference adapter" as Worker
participant "Atomic JSON writer" as Writer
Adapter -> Host : normalized facts with owned payload
Host -> Core : observation(facts, explicit now)
Core -> Core : bounded assembly; preserve exact input
Core -> Rules : assess(window, frozen contract, now)
Rules --> Core : gates + reasons + original deadline
alt candidate rejected
 Core --> Host : prior result if independently eligible,\notherwise unknown; separate diagnostics
 Host -> Writer : replace complete result record
else candidate eligible
 Core --> Host : immutable job + ID + generation
 Host ->> Worker : dispatch to free running slot
 Worker -> Worker : frozen features and model
 Worker -->> Host : class / abstention / failure + IDs
 Host -> Core : completion(outcome, new now)
 alt obsolete / unexpected / duplicate completion
  Core --> Host : discard; bounded diagnostic
 else submitted current-generation job
  Core -> Rules : recheck applicability + capture age
  Rules --> Core : current assessment
  Core -> Core : accept class / abstain / reject;\nnever refresh old evidence horizon
  Core --> Host : approved current result + separate diagnostics
  Host -> Writer : replace complete result record
 end
end
note over Host, Worker
Runner handles timers while inference executes.
Only the coordinator changes current-state semantics.
end note
@enduml
